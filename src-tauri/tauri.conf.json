{
    "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
    "productName": "File2File",
    "version": "0.1.0",
    "identifier": "com.file2file.converter",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "File2File - Universal Local Converter",
                "width": 1100,
                "height": 780,
                "minWidth": 800,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false,
                "dragDropEnabled": true,
                "center": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: blob: data:; connect-src 'self' ipc: ws://localhost:* http://localhost:*;"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/256x256.png",
            "icons/512x512.png",
            "icons/icon.png",
            "icons/icon.ico",
            "icons/icon.icns",
            "icons/icon.svg"
        ],
        "externalBin": [
            "binaries/ffmpeg",
            "binaries/ffprobe",
            "binaries/pandoc",
            "binaries/magick",
            "binaries/pdftotext",
            "binaries/pdftohtml"
        ],
        "windows": {
            "nsis": {
                "languages": [
                    "English"
                ],
                "displayLanguageSelector": false
            },
            "wix": {
                "language": [
                    "en-US"
                ]
            }
        },
        "linux": {
            "deb": {
                "depends": [
                    "libwebkit2gtk-4.1-0",
                    "libgtk-3-0",
                    "libayatana-appindicator3-1",
                    "librsvg2-2",
                    "imagemagick",
                    "pandoc",
                    "poppler-utils",
                    "ffmpeg"
                ]
            },
            "appimage": {
                "bundleMediaFramework": true
            }
        },
        "macOS": {
            "dmg": {
                "windowPosition": {
                    "x": 400,
                    "y": 200
                },
                "windowSize": {
                    "width": 540,
                    "height": 380
                },
                "appPosition": {
                    "x": 130,
                    "y": 150
                },
                "applicationFolderPosition": {
                    "x": 410,
                    "y": 150
                }
            }
        }
    },
    "plugins": {
        "shell": {
            "open": true
        }
    }
}
