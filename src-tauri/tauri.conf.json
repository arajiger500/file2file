{
    "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
    "productName": "File2File",
    "version": "0.1.0",
    "identifier": "com.file2file.app",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "File2File - Universal Local Converter",
                "width": 1100,
                "height": 780,
                "minWidth": 800,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false,
                "dragDropEnabled": true,
                "center": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/icon.svg"
        ],
        "externalBin": [
            "binaries/ffmpeg",
            "binaries/ffprobe",
            "binaries/pandoc",
            "binaries/magick",
            "binaries/pdftotext"
        ]
    },
    "plugins": {
        "shell": {
            "open": true
        }
    }
}
